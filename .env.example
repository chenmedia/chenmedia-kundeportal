# Database (Postgres). Lokalt: se README («Lokal Postgres»). I drift: Supabase.
# DATABASE_URL = pooler-adressen (port 6543, legg på ?pgbouncer=true&connection_limit=1)
# DIRECT_URL   = direkte adresse (port 5432), brukes til migrasjoner
DATABASE_URL="postgresql://postgres@localhost:5433/kundepriser_dev"
DIRECT_URL="postgresql://postgres@localhost:5433/kundepriser_dev"

# Hemmelighet brukt til å kryptere kundelenker ("Kopier lenke"). Minst 16 tegn (bruk gjerne 32+) og alltid en egen verdi i drift:
# eksempelverdien under avvises når NODE_ENV=production.
# Generer f.eks. med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="bytt-meg-lokal-utvikling-bytt-meg-lokal"

# Offentlig adresse (brukes til å bygge kundelenker). Mangler den på Vercel, brukes produksjonsadressen til prosjektet.
APP_URL="http://localhost:3000"

# Bildelagring. Med SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY brukes Supabase Storage (privat bucket).
# Uten dem brukes lokal disk i STORAGE_DIR (kun for utvikling, virker ikke på Vercel).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="kundeportal-media"
STORAGE_DIR="./storage"

# Første administrator (brukes av `npm run db:seed` og `npm run admin:create`)
ADMIN_EMAIL="kai@chenmedia.no"
ADMIN_PASSWORD=""

# E-post. La stå tomt for lokal utboks (ingenting sendes).
# Støttet leverandør: resend
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM="Chen Media <noreply@example.com>"
# Hvor varsel om nye forespørsler sendes
NOTIFY_EMAIL="kai@chenmedia.no"

# HubSpot (valgfritt). Tomt = forespørsler overføres ikke. Se README «HubSpot».
HUBSPOT_ACCESS_TOKEN=""
HUBSPOT_PIPELINE_ID=""   # skrives ut av `npm run hubspot:setup`
HUBSPOT_STAGE_NEW=""     # skrives ut av `npm run hubspot:setup`
HUBSPOT_OWNER_ID=""      # eier av deal og oppgave (gir varsel fra HubSpot). Kai: 23013495
HUBSPOT_PORTAL_ID=""     # gir lenke til dealen i admin. Chen Media: 3060835
HUBSPOT_UI_DOMAIN=""     # standard app-eu1.hubspot.com

# Sett til "1" for å legge inn to tydelig merkede eksempelforespørsler ved seed
SEED_DEMO_INQUIRIES="0"

# Cron (daglig sveip som prøver feilede e-poster på nytt, se vercel.json). Uten CRON_SECRET (minst 16 tegn)
# avviser rutene /api/cron/* alle kall. Vercel sender den automatisk som «Authorization: Bearer ...».
CRON_SECRET=""

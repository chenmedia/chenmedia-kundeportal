# Database (SQLite lokalt). Sti er relativ til prisma/schema.prisma.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Hemmelighet brukt til å kryptere kundelenker ("Kopier lenke"). Minst 32 tegn i drift.
# Generer f.eks. med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="bytt-meg-lokal-utvikling-bytt-meg-lokal"

# Offentlig adresse (brukes til å bygge kundelenker og sjekke origin)
APP_URL="http://localhost:3000"

# Mappe for opplastede bilder (må ha varig lagring og sikkerhetskopi i drift)
STORAGE_DIR="./storage"

# Første administrator (brukes av `npm run db:seed` og `npm run admin:create`)
ADMIN_EMAIL="kai@chenmedia.no"
ADMIN_PASSWORD=""

# E-post. La stå tomt for lokal utboks (ingenting sendes).
# Støttet leverandør: resend
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM="Chen Media <noreply@example.com>"
# Hvor varsel om nye forespørsler sendes
NOTIFY_EMAIL="kai@chenmedia.no"

# Sett til "1" for å legge inn to tydelig merkede eksempelforespørsler ved seed
SEED_DEMO_INQUIRIES="1"

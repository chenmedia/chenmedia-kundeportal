{
  "name": "chenmedia-kundepriser",
  "version": "0.1.0-beta",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@prisma/client": "6.19.3",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
